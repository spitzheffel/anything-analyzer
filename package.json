{
  "name": "anything-analyzer",
  "version": "3.6.63",
  "description": "Universal web protocol analyzer with embedded browser and AI-powered analysis",
  "packageManager": "pnpm@10.24.0",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:internal": "electron-vite dev --mode internal --entry out-internal/main/index.js",
    "build": "electron-vite build",
    "build:internal": "electron-vite build --mode internal",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "rebuild:native:node": "pnpm rebuild better-sqlite3",
    "test:migrations:electron": "node scripts/run-electron-vitest.mjs tests/main/db/migrations.test.ts",
    "package:internal": "pnpm build:internal && electron-builder --config electron-builder.internal.yml --publish never",
    "verify:package:public": "node scripts/verify-browser-package.mjs public dist",
    "verify:package:internal": "node scripts/verify-browser-package.mjs internal dist-internal",
    "smoke:package:public": "node scripts/smoke-packaged-app.mjs public dist",
    "smoke:package:internal": "node scripts/smoke-packaged-app.mjs internal dist-internal",
    "smoke:package:ui:internal": "node scripts/smoke-packaged-ui.mjs internal dist-internal",
    "preview": "electron-vite preview",
    "preview:internal": "electron-vite preview --mode internal --entry out-internal/main/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ --ext .ts,.tsx",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.49",
    "@ai-sdk/openai": "^4.0.60",
    "@ai-sdk/openai-compatible": "^3.0.44",
    "@ant-design/icons": "^5.6.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@vscode/sudo-prompt": "^9.3.2",
    "ai": "^7.0.93",
    "antd": "^5.24.0",
    "better-sqlite3": "^11.8.1",
    "cloakbrowser": "0.5.10",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "mmdb-lib": "^3.0.3",
    "node-forge": "^1.4.0",
    "playwright-core": "1.62.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.3",
    "react-window": "^2.2.7",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.0",
    "socks": "^2.8.7",
    "socks-proxy-agent": "^10.1.0",
    "uuid": "^11.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node-forge": "^1.3.14",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
